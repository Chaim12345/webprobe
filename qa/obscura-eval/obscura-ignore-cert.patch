diff --git a/crates/obscura-net/src/lib.rs b/crates/obscura-net/src/lib.rs
index 75661e5..526f725 100644
--- a/crates/obscura-net/src/lib.rs
+++ b/crates/obscura-net/src/lib.rs
@@ -29,3 +29,10 @@ pub use wreq_client::{
 
 mod operator_hint;
 pub use operator_hint::private_network_error_hint;
+
+/// WebProbe fork: `OBSCURA_IGNORE_CERT_ERRORS=1` accepts invalid upstream
+/// certificates on every transport of this process (the equivalent of
+/// Chromium's `--ignore-certificate-errors`). Default is strict.
+pub fn ignore_certificate_errors() -> bool {
+    std::env::var("OBSCURA_IGNORE_CERT_ERRORS").is_ok_and(|v| v == "1")
+}
